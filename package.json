{
  "name": "js-llmlab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "本地 CLI 实验室：对接 OpenAI 兼容接口，做提示词预设、会话分支与配置对比。",
  "bin": {
    "js-llmlab": "./bin/js-llmlab.mjs"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "js-llmlab": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:update-golden": "UPDATE_GOLDEN=1 tsx --test tests/*.test.ts",
    "fixture:export": "tsx scripts/export-fixture.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "openai": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
